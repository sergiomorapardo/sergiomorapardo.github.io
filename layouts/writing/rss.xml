{{- $isES := eq site.Language.Lang "es" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ cond $isES "Notas de Sergio A. Mora Pardo" "Writing by Sergio A. Mora Pardo" }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ cond $isES "Notas técnicas sobre machine learning aplicado y sistemas de IA." "Technical notes on applied machine learning and AI systems." }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml" />
    {{ range .RegularPages.ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid>{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ .Description }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
